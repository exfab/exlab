(version 0.2.0)

(build
 (all_platforms
  ((action
    (progn
     (when %{pkg-self:dev} (run dune subst))
     (run dune build -p %{pkg-self:name} -j %{jobs} @install))))))

(depends
 (all_platforms
  (ocaml dune mirage-crypto mirage-crypto-rng)))

(source
 (fetch
  (url
   https://github.com/syaiful6/passe/releases/download/0.2.0/passe-0.2.0.tbz)
  (checksum
   sha256=67b052af6a84859dfcc13438e6109062d18a9184527c5c9a5f5b1b65cc3800be)))
