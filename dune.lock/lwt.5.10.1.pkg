(version 5.10.1)

(build
 (all_platforms
  ((action
    (progn
     (when %{pkg-self:dev} (run dune subst))
     (run
      dune
      exec
      -p
      %{pkg-self:name}
      src/unix/config/discover.exe
      --
      --save
      --use-libev
      %{pkg:conf-libev:installed})
     (run dune build -p %{pkg-self:name} -j %{jobs} @install))))))

(depends
 (all_platforms
  (dune
   ocaml
   cppo
   dune-configurator
   ocplib-endian
   base-threads
   base-unix
   conf-libev)))

(source
 (fetch
  (url https://github.com/ocsigen/lwt/archive/refs/tags/5.10.1.tar.gz)
  (checksum md5=3550f2448bf94379ecd3d480eb8cb070)))
