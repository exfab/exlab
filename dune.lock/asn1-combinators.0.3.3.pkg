(version 0.3.3)

(build
 (all_platforms
  ((action
    (progn
     (when %{pkg-self:dev} (run dune subst))
     (run dune build -p %{pkg-self:name} -j %{jobs}))))))

(depends
 (all_platforms
  (ocaml dune ptime)))

(source
 (fetch
  (url
   https://github.com/mirleft/ocaml-asn1-combinators/releases/download/v0.3.3/asn1-combinators-0.3.3.tbz)
  (checksum
   sha256=f4d159a8bda7c3b186a4801448e879cced136799c68aec51fb373ce4e1284b11)))
